{
  "name": "infresco-sms",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm --filter @sms/shared build && pnpm --filter api build && pnpm --filter web build",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
